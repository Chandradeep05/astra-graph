{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "backend/app/static",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://astra-graph.onrender.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://astra-graph.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    }
  ]
}

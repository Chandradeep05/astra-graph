# ===========================================================================
# ANVAYA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in required values. Never commit real credentials.
# ===========================================================================

# --- Application Settings ---
APP_ENV=development
PORT=8000
CORS_ORIGINS=*

# --- FalkorDB Connection Settings ---
# For local Docker:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=anvaya
FALKORDB_SSL=false

# For FalkorDB Cloud (e.g. app.falkordb.cloud):
# FALKORDB_HOST=db-xxxx.cloud.falkordb.com
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_secret_password_here
# FALKORDB_GRAPH_NAME=anvaya
# FALKORDB_SSL=false

# Optional connection URI (overrides individual host/port/auth settings if provided):
# FALKORDB_URL=falkor://default:password@host:6379
